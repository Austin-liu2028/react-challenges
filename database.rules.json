{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "courseEdits": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$courseId": {
            ".validate": "newData.hasChildren(['term', 'number', 'title', 'meets'])",
            "term": {
              ".validate": "newData.isString()"
            },
            "number": {
              ".validate": "newData.isString()"
            },
            "title": {
              ".validate": "newData.isString()"
            },
            "meets": {
              ".validate": "newData.isString()"
            }
          }
        }
      }
    }
  }
}
